# --- Card-art assets ---
# All card art stays on disk only: the face deck uses personal photos and the
# painted set is the publisher's artwork, so neither belongs in a public repo.
# Without them the web client draws each card from its data instead
# (see GolemCard.jsx / MerchantCard.jsx). Regenerate locally with
# engine/make_cards.py and engine/make_merchants.py.
engine/out/
engine/out_merchants/
engine/cards.csv
engine/merchants.csv
gol/
golem-cards/
engine/photos/
engine/photos_merchants/
gol/backgrounds/
gol/merchant_backgrounds/
mer/
*_print.pdf

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- Node / Vite ---
node_modules/
web/dist/
.vite/

# --- Logs ---
*.log

# --- Bot run outputs (Step 5+) ---
# Arena results are the evidence behind every win-rate claim and are tiny
# (~2 KB a run), so they are tracked. Tuning produces a file per generation
# per run, which is not, so only its summaries are kept.
results/**
!results/
!results/**/
!results/*.md
# The measurement files REPORT.md is generated from. Without these a
# fresh clone cannot regenerate the report or check a number in it.
!results/*.json
!results/arena/**/summary.txt
!results/arena/**/result.json
!results/**/summary.json
# Tuning: the per-generation records are the curve and are ~1 KB each, so they
# are tracked. The candidate weight files (popsize per generation) and the
# pickled CMA state are not.
!results/tune/**/gen_*.json
!results/tune/**/config.json
!results/tune/**/best.json
results/tune/**/candidates/
results/tune/**/state.pkl

# --- Player avatars ---
# Photos are local-only; the client falls back to coloured letter circles.
web/public/avatars/

# --- Editor / OS ---
.claude/settings.local.json
.DS_Store
Thumbs.db
.idea/
.vscode/
