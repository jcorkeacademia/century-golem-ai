# --- Card-art assets (426 MB; regenerable from make_cards.py / make_merchants.py) ---
# Source photos and generated card PNGs are kept on disk but never tracked.
golem-cards/
engine/out/
engine/out_merchants/
engine/photos/
engine/photos_merchants/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- Node / Vite ---
node_modules/
web/dist/
.vite/

# --- Logs ---
*.log

# --- Bot run outputs (Step 5+) ---
# Arena results are the evidence behind every win-rate claim and are tiny
# (~2 KB a run), so they are tracked. Tuning produces a file per generation
# per run, which is not, so only its summaries are kept.
results/**
!results/
!results/**/
!results/*.md
!results/arena/**/summary.txt
!results/arena/**/result.json
!results/**/summary.json
!results/**/best.json

# --- Editor / OS ---
.claude/settings.local.json
.DS_Store
Thumbs.db
.idea/
.vscode/
